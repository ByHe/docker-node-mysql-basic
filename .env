# ==============================================================================
# OBS! PEDAGOGISK LÖSNING (VARNIG):
# I "verkliga" projekt och i produktion innehåller .env hemliga lösenord och 
# API-nycklar. Därför ska .env i normala fall ALLTID ligga i .gitignore och
# ALDRIG laddas upp till GitHub!
#
# I denna utbildningsmiljö kör vi lokalt med enkla standardlösenord (12345),
# och filen skickas med här enbart för att ni snabbt ska komma igång.
# ==============================================================================

# Webbserver och phpMyAdmin portar
PORT=80
PMA_PORT=8080

# Databasanslutning (MariaDB)
DB_HOST=db
DB_NAME=webbserver_db
DB_USER=root
DB_PASSWORD=12345
DB_ROOT_PASSWORD=12345
